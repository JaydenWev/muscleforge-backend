{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "https": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7243;http://localhost:5187",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "http://localhost:5187/openapi/v1.json",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "containerRunArguments": "--network muscleforge_default --publish 127.0.0.1:5187:8080",
      "publishAllPorts": false,
      "useSSL": false
    }
  }
}
