<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <UserSecretsId>muscleforge-backend-development</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfilePath>$(MSBuildProjectDirectory)/../../Dockerfile</DockerfilePath>
    <ContainerBuildContext>$(MSBuildProjectDirectory)/../..</ContainerBuildContext>
    <ContainerFastModeStage>base</ContainerFastModeStage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MuscleForge.Core/MuscleForge.Core.csproj" />
    <ProjectReference Include="../MuscleForge.Infrastructure/MuscleForge.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" PrivateAssets="all" />
  </ItemGroup>
</Project>
