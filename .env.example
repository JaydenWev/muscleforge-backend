# Copy to .env and set your own passwords. The .env file is ignored by Git.
# PostgreSQL connection password, separate from the MuscleForge login password.
POSTGRES_PASSWORD=

# MuscleForge account created on first API startup after explicit migrations.
OWNER_EMAIL=owner@example.test
# At least 12 characters with uppercase, lowercase, digit and non-alphanumeric.
# Use single quotes around values containing $ to keep them literal in Compose.
# Existing accounts/passwords are preserved on subsequent startups.
OWNER_PASSWORD=

# Encrypted PFX used to protect persistent authentication keys at rest.
DATA_PROTECTION_CERTIFICATE_FILE=./.secrets/dataprotection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=
